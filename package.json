{
  "name": "motion-learning-hub-mainlagitv-v2",
  "version": "2.0.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Mainlagi Hub motion-learning platform with ten internal hand and body motion experiences.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:portable": "tsc -p tsconfig.portable.json",
    "test:engine:core": "node scripts/run-engine-tests.mjs",
    "test:gesture": "node scripts/run-gesture-contract-tests.mjs",
    "test:interaction": "node scripts/run-air-target-tests.mjs",
    "test:tracing": "node scripts/run-guided-tracing-tests.mjs",
    "test:learning:core": "node scripts/run-learning-tests.mjs",
    "test:learning:curriculum": "node scripts/run-curriculum-tests.mjs",
    "test:learning:adaptive-v2": "node scripts/run-adaptive-v2-tests.mjs",
    "test:learning:parent-insights": "node scripts/run-parent-insights-tests.mjs",
    "test:learning:schema": "node scripts/run-learning-schema-tests.mjs",
    "test:learning:isolation": "node scripts/run-learning-isolation-tests.mjs",
    "test:learning": "npm run test:learning:core && npm run test:learning:curriculum && npm run test:learning:adaptive-v2 && npm run test:learning:parent-insights && npm run test:learning:schema && npm run test:learning:isolation",
    "test:engine": "npm run test:engine:core && npm run test:gesture && npm run test:interaction && npm run test:tracing && npm run test:learning",
    "simulate": "node scripts/run-five-simulations.mjs",
    "validate:structure": "node scripts/validate-structure.mjs",
    "validate:assets": "node scripts/validate-asset-provenance.mjs",
    "preview:build": "node scripts/build-preview.mjs",
    "check:portable": "npm run validate:structure && npm run validate:assets && npm run audit:source && npm run typecheck:portable && npm run test:engine && npm run simulate && npm run preview:build",
    "check": "npm run validate:structure && npm run validate:assets && npm run audit:source && npm run typecheck && npm run lint && npm run test:engine && npm run simulate && npm run build",
    "postinstall": "node scripts/setup-mediapipe-assets.mjs",
    "audit:source": "node scripts/audit-source.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "preview": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "upload": "npm run build:cloudflare && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@mediapipe/tasks-vision": "0.10.35",
    "@opennextjs/cloudflare": "^1.20.4",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "^16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.127.1"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.4"
  }
}
