{
  "name": "motion-learning-hub-mainlagitv-v2",
  "version": "2.0.2",
  "private": true,
  "description": "Mainlagi Hub Motion Learning Hub V2: ten internal hand and body motion experiences.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:portable": "tsc -p tsconfig.portable.json",
    "test:engine:core": "node scripts/run-engine-tests.mjs",
    "test:gesture": "node scripts/run-gesture-contract-tests.mjs",
    "test:interaction": "node scripts/run-air-target-tests.mjs",
    "test:tracing": "node scripts/run-guided-tracing-tests.mjs",
    "test:engine": "npm run test:engine:core && npm run test:gesture && npm run test:interaction && npm run test:tracing",
    "simulate": "node scripts/run-five-simulations.mjs",
    "validate:structure": "node scripts/validate-structure.mjs",
    "preview:build": "node scripts/build-preview.mjs",
    "check:portable": "npm run validate:structure && npm run audit:source && npm run typecheck:portable && npm run test:engine && npm run simulate && npm run preview:build",
    "check": "npm run validate:structure && npm run audit:source && npm run typecheck && npm run lint && npm run test:engine && npm run simulate && npm run build",
    "postinstall": "node scripts/setup-mediapipe-assets.mjs",
    "audit:source": "node scripts/audit-source.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@mediapipe/tasks-vision": "0.10.35",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
