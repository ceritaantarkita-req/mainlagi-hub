{
  "name": "motion-learning-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Privacy-first webcam motion learning games for children and families.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "qa:source": "tsc -p tsconfig.qa.json",
    "test:engine": "node scripts/run-engine-tests.mjs",
    "simulate": "node scripts/run-simulations.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:engine && npm run simulate && npm run build",
    "postinstall": "node scripts/setup-mediapipe-assets.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.12",
    "typescript": "^6.0.3"
  }
}
