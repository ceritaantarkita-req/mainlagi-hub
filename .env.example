NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Data backend: "mock" (dev, no Supabase) or "supabase" (production).
NEXT_PUBLIC_DATA_BACKEND=mock
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC. Used by trusted server-only Supabase admin paths (for example affiliate click logging and World evidence ingestion).
SUPABASE_SERVICE_ROLE_KEY=
# Optional public-facing contact email. Keep personal addresses out of the template.
NEXT_PUBLIC_ADMIN_EMAIL=
NEXT_PUBLIC_MEDIAPIPE_WASM_URL=
NEXT_PUBLIC_HAND_LANDMARKER_MODEL_URL=
NEXT_PUBLIC_POSE_LANDMARKER_MODEL_URL=

# Shop: keep sales disabled until the launch gates in docs/SHOP_IMPLEMENTATION.md pass.
SHOP_SALES_ENABLED=false
# Development only; ignored by production builds. Never enables checkout.
SHOP_LOCAL_PREVIEW=false
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
BITESHIP_API_KEY=
BITESHIP_ORIGIN_CONTACT_NAME=
BITESHIP_ORIGIN_CONTACT_PHONE=
BITESHIP_ORIGIN_ADDRESS=
BITESHIP_ORIGIN_POSTAL_CODE=
# Explicit approved courier allowlist; standard parcel + pickup only in this release.
BITESHIP_COURIERS=
BITESHIP_WEBHOOK_HEADER=
BITESHIP_WEBHOOK_SECRET=
SHOP_CRON_SECRET=
