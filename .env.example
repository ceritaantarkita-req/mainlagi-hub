NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Data backend: "mock" (dev, no Supabase) or "supabase" (production).
NEXT_PUBLIC_DATA_BACKEND=mock
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC. Used by trusted server-only Supabase admin paths (for example affiliate click logging and World evidence ingestion).
SUPABASE_SERVICE_ROLE_KEY=
# Optional public-facing contact email. Keep personal addresses out of the template.
NEXT_PUBLIC_ADMIN_EMAIL=
NEXT_PUBLIC_MEDIAPIPE_WASM_URL=
NEXT_PUBLIC_HAND_LANDMARKER_MODEL_URL=
NEXT_PUBLIC_POSE_LANDMARKER_MODEL_URL=

# Shop: keep sales disabled until the launch gates in docs/SHOP_IMPLEMENTATION.md pass.
SHOP_SALES_ENABLED=false
# Development only; ignored by production builds. Never enables checkout.
SHOP_LOCAL_PREVIEW=false
# Staging-only Batch 11 acceptance bypass. Production must leave this false/unset.
# Even when enabled, operational policy/configuration gates still apply.
SHOP_STAGING_ACCEPTANCE_ENABLED=false
SHOP_STAGING_ACCEPTANCE_SECRET=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
BITESHIP_API_KEY=
# Batch 04 operational values. Keep real pickup/contact values private in deployment env;
# do not commit them to policy JSON or documentation.
BITESHIP_ORIGIN_CONTACT_NAME=
BITESHIP_ORIGIN_CONTACT_PHONE=
BITESHIP_ORIGIN_ADDRESS=
BITESHIP_ORIGIN_POSTAL_CODE=
# Exact comma-separated owner-approved Biteship courier codes.
# Runtime requires this env list to match the approved operational-policy allowlist.
# This release only accepts parcel + pickup and excludes instant services.
BITESHIP_COURIERS=
BITESHIP_WEBHOOK_HEADER=
BITESHIP_WEBHOOK_SECRET=
SHOP_CRON_SECRET=

# Batch 09 scheduler. Configure as GitHub Actions repository secrets for the
# scheduled staging reconciliation workflow; keep them unset until a safe public
# non-production Shop origin exists.
SHOP_STAGING_URL=
# Optional retention decision. No automatic PII deletion occurs while unset.
SHOP_ORDER_PII_RETENTION_DAYS=
