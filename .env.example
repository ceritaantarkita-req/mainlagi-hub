# Where each standalone product is deployed. The hub links to these; it does not
# embed or replace them. Leave a value empty and the card renders as
# "Belum dikonfigurasi" instead of a broken link.
NEXT_PUBLIC_APP_MATH_MOTION_BATTLE=https://battle.example.com
NEXT_PUBLIC_APP_MATH_WARUNG=https://warung.example.com
NEXT_PUBLIC_APP_IQRO_MOTION=https://iqro.example.com
NEXT_PUBLIC_APP_AIRBOARD_PRESENTER=https://airboard.example.com

# Optional: serve the MediaPipe runtime from one shared origin so the five apps
# do not each ship their own 10 MB copy.
# NEXT_PUBLIC_MEDIAPIPE_WASM_URL=https://cdn.example.com/mediapipe/wasm
# NEXT_PUBLIC_HAND_LANDMARKER_MODEL_URL=https://cdn.example.com/models/hand_landmarker.task
