{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": ".qa-dist",
    "rootDir": "src/lib",
    "strict": true,
    "skipLibCheck": true,
    "declaration": false
  },
  "include": ["src/lib/engine/**/*.ts", "src/lib/vision/gesture.ts", "src/lib/vision/player-assignment.ts", "src/lib/vision/body-analysis.ts", "src/lib/vision/types.ts"],
  "exclude": ["node_modules"]
}
